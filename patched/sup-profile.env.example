# SUP (Industry OS) Hindsight profile
# Copy to ~/.hindsight/profiles/sup.env and set API key
#
# Setup:
#   1. Start Supabase: cd umbrella-sup/sup && npx supabase start
#   2. Create hindsight DB: ./scripts/ensure-hindsight-db.sh
#   3. cp patched/sup-profile.env.example ~/.hindsight/profiles/sup.env
#   4. Set HINDSIGHT_API_LLM_API_KEY and HINDSIGHT_API_REFLECT_LLM_API_KEY
#   5. hindsight-embed -p sup daemon start

# LLM (ollama-cloud)
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-oss:120b-cloud
HINDSIGHT_API_LLM_BASE_URL=https://ollama.com/v1
HINDSIGHT_API_LLM_API_KEY=<ollama-cloud-api-key>
HINDSIGHT_API_REFLECT_LLM_PROVIDER=openai
HINDSIGHT_API_REFLECT_LLM_MODEL=gpt-oss:120b-cloud
HINDSIGHT_API_REFLECT_LLM_BASE_URL=https://ollama.com/v1
HINDSIGHT_API_REFLECT_LLM_API_KEY=<ollama-cloud-api-key>

# Database (isolated from supabase db reset)
HINDSIGHT_API_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/hindsight

# Tenant (JWT/JWKS auth + schema-per-org)
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.sup_tenant:SupTenantExtension
HINDSIGHT_API_TENANT_SUPABASE_URL=http://localhost:54321

# Multilingual models
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=intfloat/multilingual-e5-small
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# No auto-exit (worker activity doesn't reset idle timer)
HINDSIGHT_EMBED_DAEMON_IDLE_TIMEOUT=0
